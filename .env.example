# Runtime
NODE_ENV=development
PORT=3007
DATABASE_URL=postgresql://flipbook:change-me@localhost:5432/flipbook
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Initial administrator (used only when the database has no admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@flipbook.local

# Alibaba Cloud OSS
OSS_ENDPOINT=
OSS_KEY_ID=
OSS_KEY_SECRET=
OSS_BUCKET=
OSS_FOLDER=flipbook

# Text and image generation
GEMINI_API_KEY=
GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta
IMAGE_PROVIDER=gptimage
GPTIMAGE_BASE_URL=https://yunwu.ai
GPTIMAGE_API_KEY=

# Minimax TTS
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# WeChat Mini Program security check
WX_MINI_APPID=
WX_MINI_SECRET=

# WeChat Pay API v3
WX_APPID=
WX_MCHID=
WX_API_V3_KEY=
WX_PUBLIC_KEY_ID=
WX_SERIAL_NO=
WX_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WX_PUBLIC_KEY_PATH=/app/certs/pub_key.pem
WX_NOTIFY_URL=
