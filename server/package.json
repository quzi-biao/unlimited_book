{
  "name": "flipbook-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:knowledge": "node --import ./scripts/local-knowledge-models.js --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node scripts/seed-prompts.js",
    "db:seed:admin": "node scripts/seed.js",
    "oss:cors": "node scripts/setup-oss-cors.js",
    "oss:fix-acl": "node scripts/fix-object-acl.js",
    "test": "node --experimental-vm-modules --test tests/*.test.js tests/knowledge/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "ali-oss": "^6.21.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mint-filter": "^4.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "prisma": "^5.22.0",
    "sharp": "^0.34.5",
    "wechatpay-node-v3": "^2.2.1",
    "ws": "^8.21.0"
  },
  "prisma": {
    "schema": "prisma"
  }
}
