<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：允许向 HTTP 明文服务器发起请求
  Android 9+ 默认禁止 HTTP，必须在此显式声明信任的域名
-->
<network-security-config>
    <!-- 允许访问线上 API 服务器（HTTP 明文） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">101.34.87.172</domain>
        <trust-anchors>
            <certificates src="@raw/server_cert" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- 本地开发时可访问内网（可选） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.138.10.122</domain>
    </domain-config>

    <!-- 默认：其余流量走 HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
